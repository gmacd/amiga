# clangd configuration for editing without the m68k toolchain. Apple clang
# has no m68k target, so parse as a 32-bit freestanding target with the same
# int/long/pointer widths. Headers come from `make ndk` (ndk-include/) with
# host-shim/ in front to replace the GCC-only inline wrappers. The GCC
# attribute macros the NDK uses are defined away. Diagnostics are
# approximate; the Docker build is the authority.
CompileFlags:
  Compiler: clang
  Add:
    # Headers opened on their own are guessed as C++ (Objective-C++ on
    # macOS); this is a C project, so parse everything as C.
    - -xc
    - --target=i386-unknown-none
    - -std=c23
    - -ffreestanding
    # Relative to the source file's directory (src/), since there is no
    # compilation database.
    - -I../host-shim
    - -I../ndk-include
    - -D__stdargs=
    - -D__regargs=
    - -D__saveds=
    - -D__interrupt=
    - -D__chip=
    - -D__far=
    - -D__near=
    - -D__aligned=
    # Match m68k GCC's integer types: there int32_t, uintptr_t and size_t
    # are long-based, on i386 int-based, which would make %lu in DBG()
    # calls look wrong to the format checker.
    - -U__INT32_TYPE__
    - "-D__INT32_TYPE__=long"
    - -U__UINT32_TYPE__
    - "-D__UINT32_TYPE__=long unsigned int"
    - -U__INTPTR_TYPE__
    - "-D__INTPTR_TYPE__=long"
    - -U__UINTPTR_TYPE__
    - "-D__UINTPTR_TYPE__=long unsigned int"
    - -U__SIZE_TYPE__
    - "-D__SIZE_TYPE__=long unsigned int"
    - -U__PTRDIFF_TYPE__
    - "-D__PTRDIFF_TYPE__=long"
    - -Wno-unknown-attributes
    - -Wno-pointer-sign
  Remove:
    - -m68020
    - -fno-tree-loop-distribute-patterns
    - -fanalyzer
    - -Wstack-usage=*
Diagnostics:
  ClangTidy:
    Add:
      # Flag any if/else/for/while body without braces, in the editor.
      - readability-braces-around-statements
